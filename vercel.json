{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/pipeline",
      "destination": "https://smart-irrigation-api-one.vercel.app/api/public/pipeline"
    },
    {
      "source": "/:path*",
      "destination": "/"
    }
  ]
}
